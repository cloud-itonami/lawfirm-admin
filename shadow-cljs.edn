;; shadow-cljs build for the lawfirm-admin appview UI.
;; Mirrors orgs/kotoba-lang/murakumo-studio/shadow-cljs.edn and
;; orgs/cloud-itonami/crypto-asset-freeze/shadow-cljs.edn:
;; CLJS + reagent on kotoba-ui.core + appkit.core (murakumo-studio構成).
{:deps {:aliases [:cljs]}
 :nrepl {:port 9632}

 :builds
 {:app
  {:target :browser
   :output-dir "appview/lawfirm-admin-mcp-component/web/dist/js"
   :asset-path "js"
   :modules {:main {:init-fn cloud-itonami.lawfirm-admin.desktop/init!}}}}}
